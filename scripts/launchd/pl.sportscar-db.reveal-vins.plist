<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>pl.sportscar-db.reveal-vins</string>
    <key>ProgramArguments</key>
    <array>
        <string>REPO/scripts/launchd/reveal_vins.sh</string>
    </array>
    <!-- Every 4 hours; a run missed while the Mac sleeps happens on wake -->
    <key>StartInterval</key>
    <integer>14400</integer>
    <key>StandardOutPath</key>
    <string>REPO/logs/reveal_vins.log</string>
    <key>StandardErrorPath</key>
    <string>REPO/logs/reveal_vins.log</string>
</dict>
</plist>
