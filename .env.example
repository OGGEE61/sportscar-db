# ── Database backend ──────────────────────────────────────────────────────────
# Set to "d1" to use Cloudflare D1, or leave as "sqlite" for local development.
DB_BACKEND=sqlite

# ── Cloudflare account ────────────────────────────────────────────────────────
# Found at: https://dash.cloudflare.com/ → right sidebar → Account ID
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# ── D1 database ID ────────────────────────────────────────────────────────────
# Shown after running: wrangler d1 create sportscar-db
# Or at: Cloudflare Dashboard → Workers & Pages → D1 → your database → Settings
CF_D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Cloudflare API token (D1 access) ─────────────────────────────────────────
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: D1:Edit (for the database above)
CF_API_TOKEN=your_cloudflare_api_token_here

# ── Flask Authentication ──────────────────────────────────────────────────────
# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_secret_key
ADMIN_PASSWORD=your_admin_password_here

# ── Scraper API token ─────────────────────────────────────────────────────────
# Shared secret between the app and the scrapers (GitHub secret API_TOKEN).
# Required in production; same generator as SECRET_KEY.
API_TOKEN=generate_a_random_api_token

# Where scrapers send data (GitHub secret API_BASE). Default: local dev server.
BASE_URL=http://127.0.0.1:5555

# ── Cloudflare R2 (photo storage, optional) ───────────────────────────────────
# Unset = photos are saved to static/photos/ instead.
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=sportscar-photos
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ── Local LLM enrichment (enrich_with_bielik.py, optional) ────────────────────
# OLLAMA_URL=http://localhost:11434/api/generate
# BIELIK_MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M
